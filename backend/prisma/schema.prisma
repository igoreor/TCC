generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Documento de origem. Os metadados bibliográficos vêm do manifesto (knowledge-base/manifest.json)
// e aparecem nas fontes das respostas. `active = false` tira o documento da busca sem apagá-lo:
// é o caso da base inicial de desenvolvimento, que não é documento oficial.
model Document {
  id              String         @id @default(uuid()) @db.Uuid
  documentId      String         @unique @map("document_id")
  title           String
  description     String?
  sourceType      String?        @map("source_type")
  sourceName      String?        @map("source_name")
  version         String?
  shortTitle      String?        @map("short_title")
  institution     String?
  authorship      String?
  publicationYear Int?           @map("publication_year")
  edition         String?
  isbn            String?
  language        String?
  jurisdiction    String?
  documentType    String?        @map("document_type")
  status          String         @default("vigente")
  active          Boolean        @default(true)
  officialUrl     String?        @map("official_url")
  downloadUrl     String?        @map("download_url")
  fileSha256      String?        @map("file_sha256")
  pageCount       Int?           @map("page_count")
  license         String?
  notes           String?
  ingestedAt      DateTime?      @map("ingested_at")
  chunks          Chunk[]
  ingestionRuns   IngestionRun[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("documents")
}

// Histórico de cada ingestão de documento: quantos trechos foram gerados, reaproveitados e
// removidos, com que modelo de embeddings e a partir de qual arquivo.
model IngestionRun {
  id              String    @id @default(uuid()) @db.Uuid
  documentId      String    @map("document_id")
  document        Document  @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  status          String
  embeddingModel  String    @map("embedding_model")
  fileSha256      String?   @map("file_sha256")
  chunksTotal     Int       @default(0) @map("chunks_total")
  chunksEmbedded  Int       @default(0) @map("chunks_embedded")
  chunksUnchanged Int       @default(0) @map("chunks_unchanged")
  chunksRemoved   Int       @default(0) @map("chunks_removed")
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([documentId])
  @@map("ingestion_runs")
}

model Chunk {
  id                       String                  @id @default(uuid()) @db.Uuid
  chunkId                  String                  @unique @map("chunk_id")
  documentId               String                  @map("document_id")
  document                 Document                @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  title                    String
  section                  String
  subsection               String?
  content                  String
  sourcePage               Int?                    @map("source_page")
  sourceReference          String?                 @map("source_reference")
  clinicalPhase            String                  @map("clinical_phase")
  informationType          String                  @map("information_type")
  targetUser               String                  @map("target_user")
  targetDemographic        String                  @map("target_demographic")
  clinicalCriticality      String                  @map("clinical_criticality")
  diseaseClassification    String                  @map("disease_classification")
  medicationRelated        Boolean                 @default(false) @map("medication_related")
  dosageRelated            Boolean                 @default(false) @map("dosage_related")
  contraindicationRelated  Boolean                 @default(false) @map("contraindication_related")
  examRelated              Boolean                 @default(false) @map("exam_related")
  diagnosisRelated         Boolean                 @default(false) @map("diagnosis_related")
  reactionRelated          Boolean                 @default(false) @map("reaction_related")
  safetyLevel              String                  @map("safety_level")
  answerPolicy             String                  @map("answer_policy")
  keywords                 Json                    @default("[]")
  entities                 Json                    @default("[]")
  metadata                 Json
  // Localização no documento: páginas do PDF (para o link #page) e números impressos (para a citação).
  chunkIndex               Int?                    @map("chunk_index")
  sectionPath              Json                    @default("[]") @map("section_path")
  pageStart                Int?                    @map("page_start")
  pageEnd                  Int?                    @map("page_end")
  pageLabelStart           String?                 @map("page_label_start")
  pageLabelEnd             String?                 @map("page_label_end")
  // Hash do texto indexado e modelo que gerou o embedding: a busca só compara vetores do mesmo
  // modelo, e a reindexação pula trechos que não mudaram.
  contentHash              String?                 @map("content_hash")
  embeddingModel           String?                 @map("embedding_model")
  // Texto sem acentos usado na busca textual (índice GIN criado na migração).
  searchText               String?                 @map("search_text")
  embedding                Unsupported("vector(1536)")?
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([documentId, chunkIndex])
  @@index([embeddingModel])
  @@index([clinicalPhase])
  @@index([informationType])
  @@index([clinicalCriticality])
  @@index([safetyLevel])
  @@map("chunks")
}

model Source {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  type         String
  url          String?
  version      String?
  lastReviewed DateTime? @map("last_reviewed")
  notes        String?

  @@map("sources")
}

// Usuários são cadastrados manualmente via SQL (ver scripts/hash-password.ts). Por isso `id` e as
// datas têm default no próprio banco, e não só no Prisma Client.
model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String        @unique
  passwordHash String        @map("password_hash")
  active       Boolean       @default(true)
  authSessions AuthSession[]
  chatSessions ChatSession[]
  feedback     Feedback[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

// Sessão de login. Guarda apenas o hash SHA-256 do token entregue no cookie.
model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userType  String        @map("user_type")
  // Opcional apenas para as conversas criadas antes da autenticação; as novas sempre têm dono.
  userId    String?       @map("user_id") @db.Uuid
  user      User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  ChatMessage[]
  logs      RetrievalLog[]
  feedback  Feedback[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  session   ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  feedback  Feedback[]
  createdAt DateTime     @default(now()) @map("created_at")

  // Alvo da chave estrangeira composta de Feedback (resposta + conversa).
  @@unique([id, sessionId])
  @@index([sessionId])
  @@map("chat_messages")
}

model RetrievalLog {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId          String?     @map("session_id") @db.Uuid
  session            ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  question           String
  retrievedChunks    Json        @map("retrieved_chunks")
  filters            Json
  scores             Json
  finalAnswer        String      @map("final_answer")
  fallbackTriggered  Boolean     @default(false) @map("fallback_triggered")
  riskLevel          String      @map("risk_level")
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("retrieval_logs")
}

// Avaliação de uma resposta da IA para a pesquisa. A nota (0 a 10) também é verificada por uma
// restrição CHECK criada na migração. A chave composta (message_id, session_id) garante que a
// conversa registrada é a da própria resposta. Registros não são apagados em cascata.
model Feedback {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  messageId String      @map("message_id") @db.Uuid
  message   ChatMessage @relation(fields: [messageId, sessionId], references: [id, sessionId], onDelete: Restrict)
  rating    Int
  comment   String?
  createdAt DateTime    @default(now()) @map("created_at")

  // Uma avaliação por usuário para cada resposta.
  @@unique([messageId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("feedback")
}

model EvaluationQuestion {
  id                  String   @id @default(uuid()) @db.Uuid
  question            String
  expectedAnswer      String   @map("expected_answer")
  idealChunks         Json     @map("ideal_chunks")
  riskLevel           String   @map("risk_level")
  correctnessCriteria String   @map("correctness_criteria")
  criticalErrors      String   @map("critical_errors")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("evaluation_questions")
}
