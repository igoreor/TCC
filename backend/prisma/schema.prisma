generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @unique @map("document_id")
  title       String
  description String?
  sourceType  String?  @map("source_type")
  sourceName  String?  @map("source_name")
  version     String?
  chunks      Chunk[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("documents")
}

model Chunk {
  id                       String                  @id @default(uuid()) @db.Uuid
  chunkId                  String                  @unique @map("chunk_id")
  documentId               String                  @map("document_id")
  document                 Document                @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  title                    String
  section                  String
  subsection               String?
  content                  String
  sourcePage               Int?                    @map("source_page")
  sourceReference          String?                 @map("source_reference")
  clinicalPhase            String                  @map("clinical_phase")
  informationType          String                  @map("information_type")
  targetUser               String                  @map("target_user")
  targetDemographic        String                  @map("target_demographic")
  clinicalCriticality      String                  @map("clinical_criticality")
  diseaseClassification    String                  @map("disease_classification")
  medicationRelated        Boolean                 @default(false) @map("medication_related")
  dosageRelated            Boolean                 @default(false) @map("dosage_related")
  contraindicationRelated  Boolean                 @default(false) @map("contraindication_related")
  examRelated              Boolean                 @default(false) @map("exam_related")
  diagnosisRelated         Boolean                 @default(false) @map("diagnosis_related")
  reactionRelated          Boolean                 @default(false) @map("reaction_related")
  safetyLevel              String                  @map("safety_level")
  answerPolicy             String                  @map("answer_policy")
  keywords                 Json                    @default("[]")
  entities                 Json                    @default("[]")
  metadata                 Json
  embedding                Unsupported("vector(1536)")?
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([clinicalPhase])
  @@index([informationType])
  @@index([clinicalCriticality])
  @@index([safetyLevel])
  @@map("chunks")
}

model Source {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  type         String
  url          String?
  version      String?
  lastReviewed DateTime? @map("last_reviewed")
  notes        String?

  @@map("sources")
}

// Usuários são cadastrados manualmente via SQL (ver scripts/hash-password.ts). Por isso `id` e as
// datas têm default no próprio banco, e não só no Prisma Client.
model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String        @unique
  passwordHash String        @map("password_hash")
  active       Boolean       @default(true)
  authSessions AuthSession[]
  chatSessions ChatSession[]
  feedback     Feedback[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

// Sessão de login. Guarda apenas o hash SHA-256 do token entregue no cookie.
model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userType  String        @map("user_type")
  // Opcional apenas para as conversas criadas antes da autenticação; as novas sempre têm dono.
  userId    String?       @map("user_id") @db.Uuid
  user      User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  ChatMessage[]
  logs      RetrievalLog[]
  feedback  Feedback[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  session   ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  feedback  Feedback[]
  createdAt DateTime     @default(now()) @map("created_at")

  // Alvo da chave estrangeira composta de Feedback (resposta + conversa).
  @@unique([id, sessionId])
  @@index([sessionId])
  @@map("chat_messages")
}

model RetrievalLog {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId          String?     @map("session_id") @db.Uuid
  session            ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  question           String
  retrievedChunks    Json        @map("retrieved_chunks")
  filters            Json
  scores             Json
  finalAnswer        String      @map("final_answer")
  fallbackTriggered  Boolean     @default(false) @map("fallback_triggered")
  riskLevel          String      @map("risk_level")
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("retrieval_logs")
}

// Avaliação de uma resposta da IA para a pesquisa. A nota (0 a 10) também é verificada por uma
// restrição CHECK criada na migração. A chave composta (message_id, session_id) garante que a
// conversa registrada é a da própria resposta. Registros não são apagados em cascata.
model Feedback {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  messageId String      @map("message_id") @db.Uuid
  message   ChatMessage @relation(fields: [messageId, sessionId], references: [id, sessionId], onDelete: Restrict)
  rating    Int
  comment   String?
  createdAt DateTime    @default(now()) @map("created_at")

  // Uma avaliação por usuário para cada resposta.
  @@unique([messageId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("feedback")
}

model EvaluationQuestion {
  id                  String   @id @default(uuid()) @db.Uuid
  question            String
  expectedAnswer      String   @map("expected_answer")
  idealChunks         Json     @map("ideal_chunks")
  riskLevel           String   @map("risk_level")
  correctnessCriteria String   @map("correctness_criteria")
  criticalErrors      String   @map("critical_errors")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("evaluation_questions")
}
