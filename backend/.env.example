DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hanseniase_rag?schema=public
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-6-luna
# Esforço de raciocínio dos modelos GPT-5/GPT-6/o-series (none, minimal, low, medium, high).
# Vazio: "none" com o gpt-6-luna; com outro modelo, o padrão dele.
CHAT_REASONING_EFFORT=
# Candidatos por lista de busca e trechos enviados ao modelo.
DEFAULT_TOP_K=20
DEFAULT_TOP_N=8
# Similaridade mínima do melhor trecho; vazio usa o padrão do provedor (0,25 OpenAI; 0,08 local).
MIN_VECTOR_SIMILARITY=
NODE_ENV=development
PORT=3333
# Sessão de login (horas). O cookie é HttpOnly e SameSite=Lax.
AUTH_SESSION_TTL_HOURS=8
# Cookie só por HTTPS: padrão ligado em produção. Use false apenas em ambiente sem TLS.
# AUTH_COOKIE_SECURE=true
# Origens que podem chamar a API com cookies (separadas por vírgula). Vazio: mesma origem (proxy do Vite).
CORS_ORIGIN=
